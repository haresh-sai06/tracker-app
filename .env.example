# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Flutter Firebase Backup Config
FLUTTER_FIREBASE_PROJECT_ID=YOUR_FLUTTER_FIREBASE_PROJECT_ID
FLUTTER_FIREBASE_API_KEY=YOUR_FLUTTER_FIREBASE_API_KEY

# Android Firebase Config
ANDROID_FIREBASE_PROJECT_ID=YOUR_ANDROID_FIREBASE_PROJECT_ID
ANDROID_FIREBASE_API_KEY=YOUR_ANDROID_FIREBASE_API_KEY
ANDROID_FIREBASE_APP_ID=YOUR_ANDROID_FIREBASE_APP_ID
ANDROID_FIREBASE_AUTH_DOMAIN=YOUR_ANDROID_FIREBASE_AUTH_DOMAIN
ANDROID_FIREBASE_STORAGE_BUCKET=YOUR_ANDROID_FIREBASE_STORAGE_BUCKET
ANDROID_FIREBASE_MESSAGING_SENDER_ID=YOUR_ANDROID_FIREBASE_MESSAGING_SENDER_ID
